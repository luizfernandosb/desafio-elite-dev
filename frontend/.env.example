# Base da API -- já inclui o prefixo /api/v1 (§ backend, "Base URL")
VITE_API_URL=http://localhost:3000/api/v1

# Supabase -- só a URL do projeto e a anon key, que são públicas por design (a anon key
# vai para o bundle; a proteção do que ela pode ler é RLS no banco, não sigilo da chave).
# Nunca SUPABASE_SERVICE_ROLE aqui -- essa fica só no back-end (§5.3.5).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=change-me-anon-key-min-20-chars

# Stripe -- chave publicável (pk_), nunca a secret key (sk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_change_me

VITE_GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com

# true liga o MSW em desenvolvimento (mocka a API sem precisar do back-end rodando).
# Nunca true em build de produção -- ver lib/env.ts e test/msw/browser.ts.
VITE_USE_MSW=false
