# Node
NODE_ENV=development
PORT=3000
TZ=UTC

# Prisma + Supabase -- ver §5.3.1. Pegar as strings prontas em Connect → ORMs → Prisma.
# Local (docker compose up -d): as duas apontam para o mesmo Postgres, portas iguais.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketdev?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ticketdev"

# JWT -- três segredos distintos e independentes (§7.2), mínimo 32 caracteres cada
JWT_ACCESS_SECRET=change-me-access-secret-32-characters-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-characters-min
JWT_QR_SECRET=change-me-qr-secret-32-characters-minimum

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_test_change_me

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=change-me-service-role-key

# Catálogo e login social
TMDB_API_KEY=change-me-tmdb-api-key
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com

LOG_LEVEL=debug   # desenvolvimento: debug | produção: info | silenciar testes: warn

# Base pública da API/front -- usada para montar o link de compartilhamento (etapa 09)
APP_PUBLIC_URL=http://localhost:5173

# Allowlist de origens para CORS, separadas por vírgula -- nunca '*'
CORS_ORIGINS=http://localhost:5173
